{
  "name": "@rodny/decap-gateway",
  "version": "0.2.0",
  "description": "An implementation of the Decap CMS Git Gateway workflow",
  "keywords": [
    "typescript",
    "library",
    "starter",
    "template"
  ],
  "homepage": "https://github.com/rodnye/decap-gateway",
  "bugs": "https://github.com/rodnye/decap-gateway/issues",
  "author": "Rodny Estrada <rrodnyestrada1@gmail.com>",
  "repository": "rodnye/decap-gateway",
  "type": "module",
  "exports": "./build/index.js",
  "types": "./build/index.d.ts",
  "license": "MIT",
  "engines": {
    "node": ">= 24"
  },
  "volta": {
    "node": "25.2.1",
    "npm": "11.6.2"
  },
  "packageManager": "pnpm@10.33.2",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "setup": "node ./scripts/setup.ts",
    "prepare": "rimraf build && tsgo --project tsconfig.build.json",
    "build": "rimraf build && tsgo --project tsconfig.build.json",
    "clean": "rimraf build coverage",
    "format": "biome format --write .",
    "type:check": "tsgo --project tsconfig.json",
    "lint": "biome check . --write --unsafe",
    "lint:check": "biome ci .",
    "test": "node --test src/**/*.test.ts",
    "test:watch": "node --test --watch src/**/*.test.ts",
    "test:coverage": "c8 -r html node --test --experimental-test-coverage src/**/*.test.ts",
    "test:setup": "node ./scripts/test-setup.ts",
    "spell:check": "cspell \"{README.md,CODE_OF_CONDUCT.md,CONTRIBUTING.md,.github/*.md,src/**/*.ts}\"",
    "cz": "cz",
    "semantic-release": "semantic-release"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@octokit/openapi-types": "^28.0.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.2",
    "@semantic-release/npm": "^13.1.3",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/node": "^25.0.9",
    "@types/prompts": "^2.4.9",
    "@typescript/native-preview": "^7.0.0-dev.20260108.1",
    "c8": "^10.1.3",
    "commitizen": "^4.3.1",
    "cspell": "^9.6.0",
    "cz-conventional-changelog": "^3.3.0",
    "dotenv": "^17.4.2",
    "prompts": "^2.4.2",
    "rimraf": "^6.1.2",
    "semantic-release": "^25.0.2",
    "slugify": "^1.6.6"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
